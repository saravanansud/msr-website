# ===========================================================================
# Midwest Specialty Robotics — Apache config for cPanel static hosting
# ===========================================================================

# Default document
DirectoryIndex index.html

# ---- Force HTTPS -----------------------------------------------------------
# Leave this COMMENTED OUT until your SSL certificate is active in cPanel
# (Namecheap AutoSSL usually issues one automatically within an hour or two).
# Once https://yourdomain works, uncomment the three lines below.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---- Gzip / Deflate compression -------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/manifest+json
</IfModule>

# ---- Browser caching -------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML: revalidate often (content can change)
  ExpiresByType text/html "access plus 1 hour"
  # Images & fonts: cache long (filenames are stable)
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  # Metadata
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ---- Correct MIME types (in case the server is old) ------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# ---- Security headers ------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Long cache for static assets folder
  <FilesMatch "\.(png|jpe?g|webp|ico|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- Block access to dotfiles & repo leftovers -----------------------------
<FilesMatch "(^\.|\.cpanel\.yml$|\.md$)">
  Require all denied
</FilesMatch>
